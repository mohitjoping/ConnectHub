# ---------------------------------------------------------------------------
# Supabase (required) — Project Settings → API keys
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The new "publishable" key (sb_publishable_...) or the legacy "anon" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional. Only the scheduled-campaign cron uses it. NEVER expose it to the
# browser (no NEXT_PUBLIC_ prefix). Secret key (sb_secret_...) or legacy service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used in email confirmation links. Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# How local-format numbers (e.g. 98765 43210) are read. ISO 3166 alpha-2.
NEXT_PUBLIC_DEFAULT_PHONE_COUNTRY=IN
# Protects /api/cron/dispatch. Vercel Cron sends it automatically. `openssl rand -hex 32`
CRON_SECRET=

# ---------------------------------------------------------------------------
# Delivery — keep these as-is unless you have provider approval.
# Live delivery ALSO requires a registered live adapter and verified
# compliance records; flipping a flag alone sends nothing.
# ---------------------------------------------------------------------------
LIVE_VOICE_ENABLED=false
LIVE_WHATSAPP_ENABLED=false
VOICE_PROVIDER=mock
WHATSAPP_PROVIDER=mock
